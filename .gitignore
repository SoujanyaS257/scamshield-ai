# ============================================================
# ScamShield AI — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (NEVER commit these — they are huge)
venv/
env/
ENV/
.venv/
.env/
scamshield-env/

# Environment Variables (NEVER commit — contains secrets/passwords)
.env
*.env
!.env.example

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ML Model files (too large for GitHub — we'll use Git LFS or cloud storage)
backend/saved_models/*.pkl
backend/saved_models/*.joblib
backend/saved_models/*.h5
backend/saved_models/*.pt
backend/saved_models/*.bin
# But track the folder structure
!backend/saved_models/.gitkeep
!backend/saved_models/distilbert_finetuned/.gitkeep

# Data files (raw datasets can be large)
data/raw/*.csv
data/raw/*.zip
data/raw/*.gz
data/processed/*.csv
# But track folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# Node.js / React
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# React build output
frontend/build/
frontend/dist/

# OS files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# IDE files
.idea/
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Docker
*.log

# Database
*.db
*.sqlite
*.sqlite3

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# Logs
logs/
*.log